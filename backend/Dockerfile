# 1. बेस इमेज सेट करें (Node.js का कौन सा वर्जन चाहिए)
FROM node:20-alpine

# 2. कंटेनर के अंदर अपना वर्किंग डायरेक्टरी सेट करें
WORKDIR /app

# 3. पहले package.json और package-lock.json को कॉपी करें
COPY package*.json ./

# 4. बैकएंड की डिपेंडेंसीज (node_modules) इंस्टॉल करें
RUN npm install

# 5. अपने बाकी सारे प्रोजेक्ट कोड को कंटेनर के अंदर कॉपी करें
COPY . .

# 6. आपका बैकएंड जिस पोर्ट पर चलता है उसे एक्सपोज करें (मान लेते हैं 5000)
EXPOSE 5000

# 7. कंटेनर चालू होते ही बैकएंड सर्वर स्टार्ट करने की कमांड
CMD ["node", "index.js"]